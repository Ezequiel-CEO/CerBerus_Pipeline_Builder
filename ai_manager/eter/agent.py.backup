    # Métodos para integração com o Framework CerBerusFMK via ponte
    
    def get_framework_component(self, component_path: str) -> Any:
        """
        Obtém um componente do framework pelo seu caminho.
        
        Args:
            component_path: Caminho do componente (módulo, classe ou função)
            
        Returns:
            Componente solicitado ou None se não disponível
        """
        if not self.has_framework_bridge:
            self.logger.error("Ponte do framework não disponível")
            return None
            
        try:
            component = self.framework.registry.get_component(component_path)
            return component
        except Exception as e:
            self.logger.error(f"Erro ao obter componente '{component_path}': {e}")
            return None
    
    def create_component_instance(self, class_path: str, *args, **kwargs) -> Any:
        """
        Cria uma instância de um componente do framework.
        
        Args:
            class_path: Caminho para a classe
            *args: Argumentos posicionais
            **kwargs: Argumentos nomeados
            
        Returns:
            Instância criada ou None se falhar
        """
        if not self.has_framework_bridge:
            self.logger.error("Ponte do framework não disponível")
            return None
            
        try:
            instance = self.framework.registry.create_instance(class_path, *args, **kwargs)
            return instance
        except Exception as e:
            self.logger.error(f"Erro ao criar instância de '{class_path}': {e}")
            return None
    
    def execute_pipeline_task(self, task_type: str, params: Dict[str, Any]) -> Dict[str, Any]:
        """
        Executa uma tarefa do pipeline com os parâmetros fornecidos.
        
        Args:
            task_type: Tipo de tarefa (collect, analyze, process)
            params: Parâmetros para a tarefa
            
        Returns:
            Resultado da tarefa
        """
        if not self.has_framework_bridge:
            self.logger.error("Ponte do framework não disponível")
            return {"status": "error", "message": "Ponte do framework não disponível"}
        
        try:
            # Obter o PipelineBuilder
            builder = self.framework.get_pipeline_builder()
            if not builder:
                return {"status": "error", "message": "PipelineBuilder não disponível"}
            
            # Executar tarefa conforme o tipo
            if task_type == "collect":
                sources = params.get("sources", [])
                results = builder.collect_content(sources)
                return {
                    "status": "success",
                    "message": f"{len(results)} fontes coletadas",
                    "data": results
                }
                
            elif task_type == "analyze":
                chunks = params.get("chunks", [])
                streaming = params.get("streaming", False)
                results = self.framework.analyze_content(chunks, streaming=streaming)
                
                # Verificar se temos resultados ou não
                if results is None:
                    return {
                        "status": "error",
                        "message": "Falha na análise de conteúdo",
                        "data": None
                    }
                
                return {
                    "status": "success",
                    "message": f"{len(results)} chunks analisados",
                    "data": results
                }
                
            elif task_type == "create_pipeline":
                name = params.get("name", f"pipeline_{int(time.time())}")
                description = params.get("description", "")
                sources = params.get("sources", [])
                pipeline = self.framework.create_pipeline(sources, name, description)
                return {
                    "status": "success" if pipeline else "error",
                    "message": f"Pipeline {name} criado" if pipeline else "Falha ao criar pipeline",
                    "data": pipeline
                }
                
            else:
                return {
                    "status": "error",
                    "message": f"Tipo de tarefa desconhecido: {task_type}"
                }
                
        except Exception as e:
            self.logger.error(f"Erro ao executar tarefa '{task_type}': {e}")
            import traceback
            self.logger.error(traceback.format_exc())
            return {
                "status": "error",
                "message": f"Erro ao executar tarefa: {str(e)}"
            }
    
    def discover_framework_capabilities(self) -> Dict[str, List[str]]:
        """
        Descobre as capacidades disponíveis no framework.
        
        Returns:
            Dicionário com listas de módulos, classes e funções
        """
        if not self.has_framework_bridge:
            self.logger.error("Ponte do framework não disponível")
            return {}
            
        return self.framework.list_available_components()
    
    def execute_framework_command(self, command: str) -> Dict[str, Any]:
        """
        Executa um comando no sistema operacional através do framework.
        
        Args:
            command: Comando a ser executado
            
        Returns:
            Resultado da execução
        """
        if not self.has_framework_bridge:
            self.logger.error("Ponte do framework não disponível")
            return {"status": "error", "message": "Ponte do framework não disponível"}
            
        return self.framework.execute_command(command)
        
    def process_user_command(self, command_text: str) -> Dict[str, Any]:
        """
        Processa um comando em linguagem natural do usuário e o executa.
        
        Esta função permite que o Èter interprete comandos em linguagem natural
        e os execute através do framework ou diretamente.
        
        Args:
            command_text: Texto do comando em linguagem natural
            
        Returns:
            Resultado do processamento do comando
        """
        self.logger.info(f"Processando comando: {command_text}")
        
        # Registrar no histórico
        if hasattr(self, 'memory') and self.memory:
            self.memory.add_conversation("user", command_text)
        
        # Verificar se temos um modelo GGUF disponível para processar o comando
        has_gguf_model = False
        if self.gguf_available:
            try:
                if not hasattr(self, 'gguf_manager') or not self.gguf_manager:
                    from cerberus_api.pipeline_builder.ai_manager.eter.gguf_loader import GGUFManager
                    # Inicializar um gerenciador GGUF para interpretar comandos
                    self.gguf_manager = GGUFManager(model_dir=self.model_dir)
                    
                # Verificar se temos algum modelo carregado
                has_gguf_model = self.gguf_manager.has_models()
            except Exception as e:
                self.logger.error(f"Erro ao verificar modelos GGUF: {e}")
                
        # Se tivermos um modelo GGUF, deixe-o procurar o comando primeiro
        command_result = None
        if has_gguf_model:
            try:
                # Criar um prompt para o modelo compreender o comando
                framework_capabilities = "desconhecido"
                if self.has_framework_bridge:
                    caps = self.discover_framework_capabilities()
                    framework_capabilities = ", ".join(
                        [f"{k}: {len(v)} itens" for k, v in caps.items()]
                    )
                
                system_prompt = f"""Você é Èter, o agente central do Framework CerBerusFMK.
Você deve analisar o comando do usuário e determinar a ação a ser executada.
Disponível: {framework_capabilities}
"""
                # Gerar a interpretação do comando
                command_interpretation = self.gguf_manager.generate_text(
                    system_prompt=system_prompt,
                    prompt=f"Comando: {command_text}\n\nAnalise e extraia o tipo de ação (collect, analyze, pipeline, system, query) e os parâmetros relevantes no formato JSON.",
                    max_tokens=1024
                )
                
                self.logger.debug(f"Interpretação do comando: {command_interpretation}")
                
                # Tentar extrair um comando estruturado da interpretação
                try:
                    import json
                    import re
                    
                    # Procurar por um bloco JSON na resposta
                    json_match = re.search(r'\{.*\}', command_interpretation, re.DOTALL)
                    if json_match:
                        cmd_data = json.loads(json_match.group(0))
                        action_type = cmd_data.get("action_type", "")
                        params = cmd_data.get("params", {})
                        
                        # Executar o comando conforme o tipo
                        if action_type in ["collect", "analyze", "create_pipeline"]:
                            command_result = self.execute_pipeline_task(action_type, params)
                        elif action_type == "system":
                            if "command" in params:
                                command_result = self.execute_framework_command(params["command"])
                        elif action_type == "query":
                            # Responder a uma consulta sobre o framework
                            command_result = {
                                "status": "success",
                                "message": "Informação obtida",
                                "data": f"Capacidades do framework: {framework_capabilities}"
                            }
                except Exception as e:
                    self.logger.error(f"Erro ao processar interpretação do comando: {e}")
            except Exception as e:
                self.logger.error(f"Erro ao usar modelo GGUF para interpretação: {e}")
        
        # Se ainda não temos um resultado (seja porque não temos modelo GGUF ou falhou)
        if not command_result:
            # Tentar processar com regras simples baseadas em palavras-chave
            command_lower = command_text.lower()
            
            if self.has_framework_bridge:
                if any(word in command_lower for word in ["coletar", "extrair", "importar"]):
                    # Comando de coleta básico
                    sources = []
                    if "http" in command_lower:
                        # Extrair URLs do comando
                        import re
                        urls = re.findall(r'https?://[^\s]+', command_text)
                        sources = urls
                    
                    command_result = self.execute_pipeline_task("collect", {"sources": sources})
                    
                elif any(word in command_lower for word in ["analisar", "processar", "entender"]):
                    # Comando de análise básico - considera o próprio texto como conteúdo a analisar
                    chunks = [command_text.replace("analisar", "").replace("processar", "").strip()]
                    command_result = self.execute_pipeline_task("analyze", {"chunks": chunks})
                    
                elif any(word in command_lower for word in ["pipeline", "fluxo", "criar"]):
                    # Comando para criar pipeline básico
                    name = f"pipeline_auto_{int(time.time())}"
                    command_result = self.execute_pipeline_task("create_pipeline", {"name": name})
                    
                elif any(word in command_lower for word in ["executar", "rodar", "comando"]):
                    # Extrai um possível comando do sistema - cuidado com segurança aqui
                    # Simplificado para exemplo, em produção seria mais complexo e seguro
                    import re
                    cmd_match = re.search(r'`(.*?)`', command_text)
                    if cmd_match:
                        command_result = self.execute_framework_command(cmd_match.group(1))
                    else:
                        command_result = {
                            "status": "error", 
                            "message": "Comando não especificado claramente entre acentos graves (`comando`)"
                        }
                        
                else:
                    # Comando desconhecido
                    capabilities = self.discover_framework_capabilities()
                    command_result = {
                        "status": "info",
                        "message": "Comando não reconhecido",
                        "data": {
                            "capabilities": capabilities,
                            "help": "Comandos disponíveis: coletar, analisar, pipeline, executar"
                        }
                    }
            else:
                command_result = {
                    "status": "error",
                    "message": "Ponte do framework não disponível e não foi possível interpretar o comando"
                }
        
        # Registrar a resposta no histórico
        if hasattr(self, 'memory') and self.memory:
            result_text = f"{command_result.get('status', 'unknown')}: {command_result.get('message', '')}"
            self.memory.add_conversation("system", result_text)
            
        return command_result

    def is_model_active(self) -> bool:
        """
        Verifica se há um modelo ativo e carregado.
        
        Returns:
            bool: True se há um modelo ativo e carregado, False caso contrário.
        """
        if not self.llm_manager:
            return False
        
        # Verificar se há um modelo ativo
        if not hasattr(self.llm_manager, 'active_model') or not self.llm_manager.active_model:
            return False
        
        # Verificar se o modelo está carregado
        if hasattr(self.llm_manager, 'is_model_loaded'):
            return self.llm_manager.is_model_loaded(self.llm_manager.active_model)
        
        # Se não conseguir verificar diretamente, assumir que se tem um active_model, está carregado
        return True 

    def __del__(self):
        """
        Método destrutor com limpeza segura de recursos CUDA.
        """
        try:
            # Liberar explicitamente recursos do modelo ativo
            if hasattr(self, '_active_model') and self._active_model:
                try:
                    if hasattr(self._model_hub, 'unload_model'):
                        self._model_hub.unload_model(self._active_model)
                    self._active_model = None
                except Exception as e:
                    print(f"Aviso: Erro ao descarregar modelo: {e}")
            
            # Limpar recursos CUDA explicitamente
            try:
                import gc
                gc.collect()
                
                # Descarregar módulos CUDA
                for name in list(sys.modules.keys()):
                    if "cuda" in name.lower() or "gpu" in name.lower() or "llama" in name.lower():
                        if name in sys.modules:
                            try:
                                del sys.modules[name]
                            except:
                                pass
            except Exception as e:
                print(f"Aviso: Erro na limpeza de módulos CUDA: {e}")
                
        except Exception as e:
            print(f"Aviso: Erro no destrutor do EterAgent: {e}")
