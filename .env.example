# Vercel Web Analytics Configuration
# 
# To enable Vercel Analytics for the Pipeline Builder dashboard:
# 1. Deploy your project to Vercel (or use Vercel CLI)
# 2. Enable Web Analytics in your Vercel project dashboard
# 3. Set VERCEL_ANALYTICS_ENABLED=true
# 
# The analytics script will be automatically injected into the Gradio interface.

# Enable/disable Vercel Analytics (set to "true" to enable)
VERCEL_ANALYTICS_ENABLED=false

# Optional: Custom Analytics ID (usually auto-configured by Vercel)
# Only set this if you need to override the default Vercel analytics path
# VERCEL_ANALYTICS_ID=your-analytics-id

# Other environment variables for the Pipeline Builder
# Add your other configuration here...
